{
  "name": "doctors-diary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:policies": "node --env-file=.env.local scripts/apply-policies.mjs",
    "db:verify": "node --env-file=.env.local scripts/verify-security.mjs",
    "db:verify:patients": "node --env-file=.env.local scripts/verify-patients.mjs",
    "db:verify:templates": "node --env-file=.env.local scripts/verify-templates.mjs",
    "db:verify:appointments": "node --env-file=.env.local scripts/verify-appointments.mjs",
    "db:verify:queue": "node --env-file=.env.local scripts/verify-queue.mjs",
    "db:verify:encounters": "node --env-file=.env.local scripts/verify-encounters.mjs",
    "db:verify:prescriptions": "node --env-file=.env.local scripts/verify-prescriptions.mjs",
    "db:verify:freeze": "node --env-file=.env.local scripts/verify-signature-freeze.mjs",
    "db:verify:handover": "node --env-file=.env.local scripts/verify-handover.mjs",
    "db:verify:api": "node --env-file=.env.local scripts/verify-api-auth.mjs",
    "db:verify:correction": "node --env-file=.env.local scripts/verify-correction.mjs",
    "db:verify:identity": "node --env-file=.env.local scripts/verify-doctor-identity.mjs",
    "db:verify:close": "node --env-file=.env.local scripts/verify-encounter-close.mjs",
    "db:verify:history": "node --env-file=.env.local scripts/verify-history.mjs",
    "db:verify:qa-provenance": "node --env-file=.env.local scripts/verify-qa-provenance.mjs",
    "db:verify:qa-cleanup": "node --env-file=.env.local scripts/verify-qa-cleanup.mjs",
    "db:verify:rx-immutable": "node --env-file=.env.local scripts/verify-rx-immutability.mjs",
    "db:verify:rx-v4": "node --env-file=.env.local scripts/verify-rx-v4.mjs",
    "db:verify:profile": "node --env-file=.env.local scripts/verify-professional-profile.mjs",
    "db:verify:migrations": "node --env-file=.env.local scripts/verify-migrations.mjs",
    "db:gate": "node --env-file=.env.local scripts/security-gate.mjs",
    "qa:create": "node --env-file=.env.local scripts/qa-fixture.mjs create",
    "qa:destroy": "node --env-file=.env.local scripts/qa-fixture.mjs destroy",
    "qa:status": "node --env-file=.env.local scripts/qa-fixture.mjs status"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
