# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the TEMPLATE, which is documentation and holds only placeholders.
# It was ignored along with everything else and had therefore never been
# committed — so a fresh clone came with no record of which variables the app
# needs, including the service-role key that Stage 7C made mandatory on the
# server. Verified before un-ignoring: no project ref, no key material, no
# password. Real values live in .env.local, which stays ignored.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# QA fixture provenance — throwaway ids on one developer's machine.
# `qa:destroy` deletes storage only under ids this file proves it created.
.qa-fixture-uids.json
