# Doctor's Diary — environment template
# Copy to .env.local. NEVER commit .env.local. NEVER paste secrets into chat.

# =============================================================================
# SUPABASE
# =============================================================================

# Browser-safe. Public project endpoint; authorization remains RLS/RPC authority.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Browser-safe site origin used for auth redirect/callback links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Postgres — SERVER/LOCAL TOOLING ONLY.
#
# DATABASE_URL  transaction pooler, port 6543 — migration/tooling compatibility.
# DIRECT_URL    session pooler,     port 5432 — migrations and verification.
#
# The deployed request path talks to Supabase over HTTP and does not need these
# database credentials. Never expose either value through NEXT_PUBLIC_*.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:6543/postgres
DIRECT_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# SUPABASE SERVICE ROLE — SERVER ONLY, BYPASSES RLS.
#
# Required by the accepted prescription signature-freeze path. The contained
# runtime client exposes Storage only; migrations/QA tooling may also use this
# credential. It must NEVER be prefixed NEXT_PUBLIC_, returned to the browser,
# logged, pasted into issues/PRs/chat, or used as a general request-path DB
# client. Rotate it immediately if exposure is suspected.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# VOICE / AI SECURITY
# =============================================================================

# SERVER ONLY. Permanent Deepgram credential used only by the server token-grant
# endpoint. The browser receives a short-lived temporary grant, never this key.
DEEPGRAM_API_KEY=

# SERVER ONLY. Integrity/signing secret for PA1 proposal handles. Required only
# when PA1 proposal acceptance/integration is explicitly opened. Use a strong
# independent random secret and rotate on suspected exposure; rotation invalidates
# outstanding proposal handles.
PA1_PROPOSAL_SIGNING_SECRET=

# SERVER ONLY — SYNTHETIC EVALUATION ONLY until Central opens a separate clinical
# privacy/provider gate. Do not enable for real patient content.
OPENAI_API_KEY=

# Synthetic-evaluation switch. Must remain disabled in pilot clinical runtime.
# The accepted evaluator recognizes the literal value "enabled".
PA1_SYNTHETIC_AI_EVAL=disabled

# =============================================================================
# PROVIDER / PRODUCT MODES
# =============================================================================

# Keep mock unless an independently approved integration explicitly requires live.
AI_MODE=mock

# No paid/live notification provider without a separate approval.
NOTIFICATION_MODE=mock

# Keep payment behavior in the approved pilot mode.
PAYMENT_MODE=mock
