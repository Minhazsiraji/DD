# Doctor's Diary — environment template
# Copy to .env.local. NEVER commit .env.local. NEVER paste secrets into chat.

# =============================================================================
# SUPABASE  (required from Phase 2)
# Dashboard -> Project Settings -> API
# =============================================================================

# Public. Safe in the browser bundle. Subject to RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Used to build auth redirect/callback links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Postgres. TWO connection strings, and they are not interchangeable.
#
# DATABASE_URL  transaction pooler, port 6543 — app runtime.
# DIRECT_URL    session pooler,     port 5432 — migrations and scripts.
#               The transaction pooler cannot run DDL, so pointing migrations
#               at it fails confusingly.
#
# A '@' in the password MUST be percent-encoded as %40, or the URL parser reads
# the password as the host.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:6543/postgres
DIRECT_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# ⚠ SERVICE ROLE KEY — BYPASSES ROW LEVEL SECURITY ENTIRELY.
#
# REQUIRED ON THE SERVER FROM STAGE 7C ONWARDS. This is not optional any more.
#
# `prescription-assets` deliberately has no INSERT policy, so ONLY trusted
# server code can freeze a prescription's signature. Without this key the app
# refuses to prepare a prescription for final review, with a configuration
# message — it fails closed, and it also fails to work. A deployment that
# follows this file without setting it will look fine until the first doctor
# tries to sign something.
#
# Set it as a SERVER environment variable on the host (Vercel: Environment
# Variables, all environments that serve the app). It must NEVER be prefixed
# NEXT_PUBLIC_, never returned from a Server Action, and never logged.
# Only `src/lib/supabase/service.ts` reads it, and it exposes `.storage` alone.
#
# Put the value in .env.local yourself. Do not paste it into chat, a PR or an
# issue. Never weaken the Storage policy because this is missing.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# VOICE TRANSCRIPTION PILOT
# =============================================================================

# Deepgram Nova-3 pilot. SERVER-ONLY.
# Create this in Deepgram and set it in the deployment environment yourself.
# Never prefix NEXT_PUBLIC_, paste it into chat, commit it, log it, or return it
# from an API response. If missing, Deepgram dictation fails closed and the
# doctor can keep typing or choose Browser fallback.
DEEPGRAM_API_KEY=

# =============================================================================
# PROVIDER MODES — mock is mandatory until each is explicitly approved.
# =============================================================================

# Live AI additionally requires a per-clinic opt-in flag in the database.
AI_MODE=mock

# No paid SMS or voice APIs.
NOTIFICATION_MODE=mock

# Manual entry only (cash / bKash / Nagad / card recorded by hand).
PAYMENT_MODE=mock
